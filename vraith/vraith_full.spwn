// Zigzag haut : plafond Y=3, sol Y=0 → passage Y=1-2
// Zigzag bas  : plafond Y=2, sol Y=0 → passage Y=1

// Zigzag HAUT (4 blocs)
for i in 577..581 { $.add(obj { OBJ_ID: 1, X: i*G+OX, Y: GY+3*G }) }
// Spike dans le passage (1 bloc libre)
