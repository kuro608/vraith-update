  "formats_objet_raw": {
    "_description": "Format raw GD pour import direct (.gmd / .lvl)",
    "structure": "k,v,k,v,...; (clé numérique, valeur, séparés par virgules, objet terminé par ;)",
    "cles_principales": {
      "1":   "OBJ_ID — type d'objet",
      "2":   "X — position horizontale (unités internes, 1 bloc = 30u)",
      "3":   "Y — position verticale (unités internes)",
      "4":   "FLIP_X — miroir horizontal (0/1)",
      "5":   "FLIP_Y — miroir vertical (0/1)",
      "6":   "ROTATION — rotation en degrés",
      "21":  "COLOR_1 — ID couleur principale",
      "22":  "COLOR_2 — ID couleur secondaire",
      "24":  "Z_LAYER — couche d'affichage",
      "25":  "Z_ORDER",
      "41":  "UNKNOWN_41",
      "57":  "GROUPS — groupes séparés par point-virgule (ex: 57,1;2;3)",
      "67":  "UNKNOWN_67",
      "155": "UNKNOWN_155"
    },
    "exemple_bloc_simple": "1,1,2,195,3,105;",
    "exemple_spike":       "1,8,2,645,3,135;",
    "exemple_orbe_jaune":  "1,84,2,675,3,135;",
    "exemple_groupe":      "1,1,2,195,3,105,57,21;",
    "conversion_coordonnees": {
      "x_raw": "bloc_index × 30 + 195",
      "y_raw": "rangee × 30 + 105",
      "sol_y": 105,
      "bloc_suivant_y": 135,
      "offset_joueur_x": 195
    }
  },

